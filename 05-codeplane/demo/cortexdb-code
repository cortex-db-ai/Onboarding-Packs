#!/usr/bin/env bash
# cortexdb-code: one-line lifecycle for CortexDB Codeplane on a repository.
#
#   cortexdb-code init     -> server up (if needed), this repo indexed, harness wired
#   cortexdb-code add PATH -> index a second repo on the same server
#   cortexdb-code status   -> server + repo + harness health
#   cortexdb-code doctor   -> diagnose what is broken and say what to run
#   cortexdb-code eject    -> export everything, remove the repo, unwire the harness
#
# Design principles:
#   1. onboard in one line      2. usage is seamless      3. grow in one line
#   4. offboard with a dump
#
# Configuration (env, all optional):
#   CORTEXDB_URL     default http://127.0.0.1:3142 (or reuse an existing server)
#   CORTEXDB_API_KEY default codeplane-local-key (self-host operator key)
#   CORTEXDB_ACTOR   default user:dev
#   CORTEXDB_SCOPE   default org:demo/team:eng
#   CORTEXDB_CODE_IMAGE  default cortexdb/cortexdb:v0.10.5
#   CORTEXDB_CODE_DATA    default docker volume cortexdb_code_data
#
# The code plane needs NO embedding key (structural mode: path, graph, BM25).
# Memory features need the server to have embedding env; init does not require it.
set -euo pipefail

CORTEXDB_URL="${CORTEXDB_URL:-http://127.0.0.1:3142}"
CORTEXDB_API_KEY="${CORTEXDB_API_KEY:-codeplane-local-key}"
CORTEXDB_ACTOR="${CORTEXDB_ACTOR:-user:dev}"
CORTEXDB_SCOPE="${CORTEXDB_SCOPE:-org:demo/team:eng}"
IMAGE="${CORTEXDB_CODE_IMAGE:-cortexdb/cortexdb:v0.10.5}"
VOLUME="${CORTEXDB_CODE_DATA:-cortexdb_code_data}"
CONTAINER="${CORTEXDB_CODE_CONTAINER:-cortexdb-codeplane}"
PORT="${CORTEXDB_URL##*:}"
REPO_NAME="$(basename "$PWD" | tr -c 'A-Za-z0-9_-' '-' | sed 's/-*$//')"
RULES_BEGIN="## CortexDB Codeplane (code intelligence + memory)"
HDR=(-H "Authorization: Bearer ${CORTEXDB_API_KEY}" -H "X-Cortex-Actor: ${CORTEXDB_ACTOR}" -H "Content-Type: application/json")

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m ok\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31mFAIL\033[0m %s\n' "$*"; exit 1; }

server_up() {
  curl -fsS -m 3 "${CORTEXDB_URL}/v1/health" >/dev/null 2>&1
}

ensure_server() {
  if server_up; then ok "server already up at ${CORTEXDB_URL}"; return; fi
  command -v docker >/dev/null 2>&1 || fail "no CortexDB server at ${CORTEXDB_URL} and no docker to start one"
  log "starting CortexDB (${IMAGE}) with the code plane on, port ${PORT}"
  docker run -d --name "$CONTAINER" \
    -p "127.0.0.1:${PORT}:3141" \
    -e CORTEX_CODE_PLANE=1 \
    -e CORTEX_CODE_WATCH=1 \
    -e CORTEX_CODE_BUNDLE=1 \
    -e CORTEX_API_KEY="${CORTEXDB_API_KEY}" \
    -v "${VOLUME}:/data" \
    -v "$PWD:/repos/${REPO_NAME}:ro" \
    "$IMAGE" >/dev/null
  for _ in $(seq 1 60); do
    server_up && { ok "server healthy at ${CORTEXDB_URL}"; return; }
    sleep 2
  done
  docker logs --tail=30 "$CONTAINER" >&2 || true
  fail "server did not become healthy"
}

register() {
  local name="$1" path="$2"
  log "registering '${name}' from ${path} under ${CORTEXDB_SCOPE}"
  # registration is a create, not a rebind: remove a stale name first
  curl -fsS -m 30 -X DELETE "${HDR[@]}" "${CORTEXDB_URL}/v1/code/repos/${name}" >/dev/null 2>&1 || true
  local t0=$SECONDS
  curl -fsS -m 300 -X POST "${HDR[@]}" "${CORTEXDB_URL}/v1/code/repos" \
    -d "{\"name\":\"${name}\",\"path\":\"${path}\",\"scope\":\"${CORTEXDB_SCOPE}\"}" \
    | python3 -c "import json,sys; d=json.load(sys.stdin); s=d.get('stats',{}); pc=s.get('predicate_counts',{}); print('    files=%s definitions=%s facts=%s calls=%s' % (s.get('files'), s.get('definitions'), s.get('facts'), pc.get('calls')))"
  echo "    indexed in $((SECONDS-t0))s"
}

wire_harness() {
  # Claude Code: project .mcp.json + rules block in CLAUDE.md
  if [ -f .mcp.json ] && grep -q cortexdb .mcp.json 2>/dev/null; then
    ok "Claude Code MCP already wired (.mcp.json)"
  else
    log "wiring Claude Code MCP (project .mcp.json)"
    python3 - "$CORTEXDB_URL" "$CORTEXDB_API_KEY" "$CORTEXDB_ACTOR" "$CORTEXDB_SCOPE" <<'PY'
import json, sys, pathlib
url, key, actor, scope = sys.argv[1:5]
cfg = {"mcpServers": {"cortexdb": {"type": "stdio", "command": "cortexdb-mcp",
        "args": [], "env": {"CORTEXDB_URL": url, "CORTEXDB_API_KEY": key,
        "CORTEXDB_ACTOR": actor, "CORTEXDB_SCOPE": scope}}}}
p = pathlib.Path(".mcp.json")
existing = json.loads(p.read_text()) if p.exists() else {"mcpServers": {}}
existing.setdefault("mcpServers", {})["cortexdb"] = cfg["mcpServers"]["cortexdb"]
p.write_text(json.dumps(existing, indent=2) + "\n")
print("    wrote .mcp.json")
PY
    ok ".mcp.json written (cortexdb server)"
  fi
  if grep -q "^${RULES_BEGIN}" CLAUDE.md 2>/dev/null; then
    ok "rules block already in CLAUDE.md"
  else
    log "appending CortexDB rules block to CLAUDE.md"
    cat >> CLAUDE.md <<'RULES'

## CortexDB Codeplane (code intelligence + memory)

This checkout is served by CortexDB over MCP (server `cortexdb`). Use its
tools BEFORE searching the filesystem:

- Locating code, "where does X happen", "what calls Y": `code_explore`
  with token_budget 1200 or less. Cited snippets, verbatim, with line ranges.
- Before changing a signature or behavior: `code_impact` on the symbol
  first; name every affected caller before editing.
- Structure browsing: `code_inventory` / `code_graph`, not grep sweeps.
- "Why is this code like this", past decisions and bugs: `memory_search`.
- After a non-obvious change or learned constraint: `memory_store` one
  short factual note.
- Keep every code_explore budget at or under 1500 tokens; never dump big
  workspace packs when a narrow query answers.
- If CortexDB errors, fall back to normal search.
RULES
    ok "rules block appended to CLAUDE.md"
  fi
}

unwire_harness() {
  if [ -f .mcp.json ]; then
    python3 - <<'PY' || true
import json, pathlib
p = pathlib.Path(".mcp.json")
try:
    d = json.loads(p.read_text())
    d.get("mcpServers", {}).pop("cortexdb", None)
    p.write_text(json.dumps(d, indent=2) + "\n")
except Exception:
    pass
PY
    ok ".mcp.json: cortexdb server removed"
  fi
  if [ -f CLAUDE.md ]; then
    python3 - "$RULES_BEGIN" <<'PY' || true
import sys, pathlib
marker = sys.argv[1]
p = pathlib.Path("CLAUDE.md")
lines = p.read_text().splitlines(keepends=True)
out, skipping = [], False
for line in lines:
    if line.rstrip("\n") == marker:
        skipping = True
        continue
    if skipping and line.startswith("## "):
        skipping = False
    if not skipping:
        out.append(line)
p.write_text("".join(out).rstrip("\n") + "\n")
PY
    ok "CLAUDE.md: rules block removed"
  fi
}

verify() {
  local name="$1"
  log "verify: symbol probe on '${name}'"
  local body
  body="$(curl -fsS -m 30 "${HDR[@]}" \
    "${CORTEXDB_URL}/v1/code/symbol/search?repo=${name}&prefix=New&limit=3" 2>/dev/null || true)"
  [[ "$body" == *'"name"'* ]] && ok "index answers symbol queries" || fail "index not answering"
  log "verify: evidence envelope"
  curl -fsS -m 60 -X POST "${HDR[@]}" "${CORTEXDB_URL}/v1/code/context" \
    -d "{\"repo\":\"${name}\",\"task\":\"entry point and main flow of this repository\",\"token_budget\":900}" \
    | python3 -c "import json,sys; d=json.load(sys.stdin)['envelope']; print('    files_considered=%s files_included=%s tokens_used=%s' % (d.get('files_considered'), d.get('files_included'), d.get('tokens_used')))"
  ok "context envelope served with citations"
}

cmd_init() {
  log "CortexDB Codeplane init on ${REPO_NAME} (${PWD})"
  ensure_server
  register "$REPO_NAME" "/repos/${REPO_NAME}"
  wire_harness
  verify "$REPO_NAME"
  echo
  ok "done. Claude Code in this repo now has CortexDB (restart Claude Code to load MCP)."
  echo "    server: ${CORTEXDB_URL}   scope: ${CORTEXDB_SCOPE}   repo: ${REPO_NAME}"
}

cmd_add() {
  local path="${1:?usage: cortexdb-code add <path> [name]}"
  local name="${2:-$(basename "$path" | tr -c 'A-Za-z0-9_-' '-' | sed 's/-*$//')}"
  server_up || fail "no server at ${CORTEXDB_URL}; run cortexdb-code init first"
  log "growing: second repo '${name}' on the same server"
  docker cp "$path" "${CONTAINER}:/repos/${name}" >/dev/null 2>&1 \
    || { [[ -d "$path" ]] || fail "path not found: $path"; }
  local in_container
  in_container="$(docker exec "$CONTAINER" sh -c "ls -d /repos/${name} 2>/dev/null" 2>/dev/null || true)"
  if [[ -z "$in_container" ]]; then
    # server not ours or path not mounted: try docker volume-less path via absolute host path (works when server runs on host)
    register "$name" "$path"
  else
    register "$name" "/repos/${name}"
  fi
  ok "'${name}' indexed on the same server; cross-repo questions now work via code_explore with repos"
}

cmd_status() {
  server_up && ok "server up at ${CORTEXDB_URL}" || fail "server down at ${CORTEXDB_URL}"
  curl -fsS -m 15 "${HDR[@]}" "${CORTEXDB_URL}/v1/code/repos" \
    | python3 -c "import json,sys; d=json.load(sys.stdin); rs=d.get('repos',[]); print('%d repo(s) served:' % len(rs)); [print('    %s: %s files, scope %s' % (r.get('name'), r.get('stats',{}).get('files'), r.get('scope'))) for r in rs]" \
    || fail "cannot list repos"
  [ -f .mcp.json ] && grep -q cortexdb .mcp.json && ok "Claude Code wired (.mcp.json)" || echo "    harness not wired in this dir"
}

cmd_doctor() {
  local bad=0
  command -v python3 >/dev/null || { fail "python3 missing"; }
  command -v cortexdb-mcp >/dev/null && ok "cortexdb-mcp on PATH" || { fail "cortexdb-mcp missing: pip install cortexdb-mcp (>= 0.8.0)"; bad=1; }
  server_up && ok "server healthy" || { echo "    server down -> run: cortexdb-code init (or start your server)"; bad=1; }
  if server_up; then
    curl -fsS -m 10 "${HDR[@]}" "${CORTEXDB_URL}/v1/code/repos" >/dev/null \
      && ok "API key accepted" || { fail "API key rejected: check CORTEXDB_API_KEY vs server CORTEX_API_KEY"; bad=1; }
  fi
  [ -f .mcp.json ] && grep -q cortexdb .mcp.json && ok "MCP wired" || { echo "    .mcp.json missing cortexdb server (run init)"; bad=1; }
  [ $bad -eq 0 ] && ok "everything healthy" || exit 1
}

cmd_eject() {
  local name="${1:-$REPO_NAME}"
  local out="cortexdb-eject-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$out"
  server_up || fail "server down; cannot export"
  log "eject: exporting memory (events+facts, JSONL)"
  cortexdb export -o "${out}/memory.jsonl" -S "$CORTEXDB_SCOPE" \
    --include events --include facts >/dev/null 2>&1 \
    || curl -fsS -m 60 -X POST "${HDR[@]}" "${CORTEXDB_URL}/v1/export" \
        -d "{\"scope\":\"${CORTEXDB_SCOPE}\",\"format\":\"jsonl\"}" > "${out}/memory-events.jsonl" \
    || echo "    memory export skipped (no memory in scope)"
  log "eject: exporting code index bundle (hash-verified)"
  cortexdb code export-index "$name" "${out}/${name}.index-bundle" \
    --endpoint "$CORTEXDB_URL" --api-key "$CORTEXDB_API_KEY" --actor "$CORTEXDB_ACTOR" >/dev/null 2>&1 \
    || curl -fsS -m 120 "${HDR[@]}" "${CORTEXDB_URL}/v1/code/export-index?repo=${name}" > "${out}/${name}.index-bundle" \
    || echo "    index export unavailable"
  log "eject: exporting call graph slice (json + dot)"
  for fmt in json dot; do
    curl -fsS -m 60 -X POST "${HDR[@]}" "${CORTEXDB_URL}/v1/code/graph/query" \
      -d "{\"repo\":\"${name}\",\"roots\":[],\"predicates\":[\"calls\"],\"output\":\"${fmt}\"}" \
      > "${out}/graph.${fmt}" 2>/dev/null || true
  done
  log "eject: removing repo '${name}' from the server (purges its bytes)"
  curl -fsS -m 60 -X DELETE "${HDR[@]}" "${CORTEXDB_URL}/v1/code/repos/${name}" \
    | python3 -c "import json,sys; d=json.load(sys.stdin); p=d.get('purge',{}); print('    removed=%s bytes_freed=%s' % (d.get('removed'), p.get('bytes_freed')))" 2>/dev/null \
    || echo "    (repo not registered or already removed)"
  unwire_harness
  ok "ejected. Take your data: ${out}/ (memory JSONL, index bundle, graph). Nothing stays on the server."
}

case "${1:-}" in
  init)   shift; cmd_init ;;
  add)    shift; cmd_add "$@" ;;
  status) shift; cmd_status ;;
  doctor) shift; cmd_doctor ;;
  eject)  shift; cmd_eject "$@" ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

# ============================================================================
#  CortexDB SERVER environment file  (enrichment OFF / content-only mode)
#
#  WHAT THIS IS: the env file for the cortexdb *container*, loaded via
#      docker run ... --env-file cortex.env cortexdb/cortexdb:v0.10.1 3141 /data
#  It configures the server's own LLM / embedding / media providers.
#
#  NOT the same as client credentials. The connectors, MCP server, SDK, and CLI
#  authenticate with a SEPARATE set of vars (CORTEXDB_URL, CORTEXDB_API_KEY,
#  CORTEXDB_ACTOR, CORTEXDB_SCOPE), which are NOT set here. The token a client
#  sends as CORTEXDB_API_KEY must equal CORTEX_API_KEY below, i.e. `noauth-local`
#  for a local trial. See the setup guide's section 6b credentials cheat-sheet.
#
#  TO USE: copy to `cortex.env`, uncomment ONE embedding block ([A] or [B], below), replace
#  every <YOUR_OPENAI_API_KEY>, then launch.
#  DO NOT commit the filled-in cortex.env: it holds a live API key.
#
#  Model split:
#    * Answers                          -> OpenAI gpt-5.6-terra (best quality per dollar)
#    * Entity extraction / enrichment   -> OpenAI gpt-4o-mini (cheapest reliable extraction)
#    * Embeddings                       -> YOUR CHOICE, see the Embeddings block below:
#                                          [A] local Ollama or [B] OpenAI API. Both are fully supported.
# ============================================================================

# --- LLM: OpenAI cloud (answers / entity extraction / verifier) ---
#   Uses an OpenAI-compatible API. To use a different provider (Azure OpenAI, Together,
#   a self-hosted vLLM, etc.) change the *_URL / *_MODEL below and keep PROVIDER=openai.
#   Recommended models (OpenAI list prices, September 2026):
#     answers            gpt-5.6-terra   best quality per dollar, about 2 to 4 cents per answer
#       budget option    gpt-5.6-luna    about 0.2 to 0.4 cents per answer (high volume, simpler questions)
#       premium option   gpt-5.6-sol     4 to 7 cents per answer (use Sol rather than gpt-6-astra, which
#                                        expects max_completion_tokens and does not run on this lane)
#     entity extraction  gpt-4o-mini     cheapest reliable extraction model
CORTEX_ANSWER_PROVIDER=openai
CORTEX_LLM_MODEL=gpt-4o-mini
CORTEX_ANSWER_MODEL=gpt-5.6-terra
CORTEX_VERIFIER_MODEL=gpt-4o
CORTEX_LLM_URL=https://api.openai.com/v1
CORTEX_ANSWER_URL=https://api.openai.com/v1
CORTEX_VERIFIER_URL=https://api.openai.com/v1
CORTEX_ANSWER_API_KEY=<YOUR_OPENAI_API_KEY>
CORTEX_VERIFIER_API_KEY=<YOUR_OPENAI_API_KEY>
CORTEX_ENTITY_API_KEY=<YOUR_OPENAI_API_KEY>
# Cheapest answers: set CORTEX_ANSWER_MODEL=gpt-5.6-luna. The configured model always answers;
# a per-request answer_model on /v1/answer is only echoed in the diagnostics.
# Cloud can handle real concurrency (raise if you hit throughput limits, lower on 429s):
CORTEX_LLM_MAX_IN_FLIGHT=4
# Rates for the usage dashboard, which has no built-in price for the GPT-5.6 / GPT-6 models;
# USD per million tokens, input/output.
CORTEX_MODEL_PRICES=gpt-5.6-terra=2/12,gpt-5.6-luna=0.2/1.2,gpt-5.6-sol=4/20,gpt-6-astra=10/50

# --- Embeddings: choose EXACTLY ONE of [A] or [B] and uncomment that block ---------------
#   Both options are fully supported and give the same product behaviour; they differ only in
#   where the embedding model runs.
#
#   [A] Local Ollama   Free per call, vectors never leave your machine. Needs the Ollama
#                      container + the nomic-embed-text model (guide section 2A) and enough
#                      CPU/RAM to run it (fine on most desktops; slow or heavy on small machines).
#   [B] OpenAI API     No extra container, no local model, reuses the same OpenAI key as the
#                      LLM. Pick this if your machine has modest hardware (a laptop, no GPU,
#                      limited RAM or disk) or you simply want fewer moving parts. Costs a
#                      fraction of a cent per thousand tokens embedded.
#
#   DECIDE BEFORE THE FIRST WRITE: the embedding model and its dimensions are pinned to the
#   data volume on first use. Switching later needs the vector rebuild described in the
#   guide's Upgrading section. Activate one block: the server refuses to start without an
#   embedding endpoint.

# [A] Local Ollama (guide section 2A) >>> uncomment these four lines to choose A.
#     The API key is a dummy: Ollama ignores it, but the server requires a non-empty string.
# CORTEX_EMBEDDING_MODEL=nomic-embed-text
# CORTEX_EMBEDDING_URL=http://ollama:11434
# CORTEX_EMBEDDING_API_KEY=ollama-local
# CORTEX_EMBEDDING_DIMS=768

# [B] OpenAI API (guide section 2B) >>> uncomment these five lines to choose B.
# CORTEX_EMBEDDING_PROVIDER=openai
# CORTEX_EMBEDDING_URL=https://api.openai.com/v1
# CORTEX_EMBEDDING_MODEL=text-embedding-3-small
# CORTEX_EMBEDDING_DIMS=1536
# CORTEX_EMBEDDING_API_KEY=<YOUR_OPENAI_API_KEY>
# ------------------------------------------------------------------------------------------

# --- Fully-local / zero-cost fallback (optional) --------------------------------
#   Prefer no cloud LLM at all? Comment out the OpenAI LLM block above and use these
#   instead (also `ollama pull qwen2.5:14b-instruct`). Requires the Ollama container from
#   embedding option [A]. Answer quality is below gpt-5.6-terra.
#   NOTE: 14B is about 9 GB and realistically needs a GPU; it is slow on CPU-only hardware.
# CORTEX_LLM_MODEL=qwen2.5:14b-instruct
# CORTEX_ANSWER_MODEL=qwen2.5:14b-instruct
# CORTEX_VERIFIER_MODEL=qwen2.5:14b-instruct
# CORTEX_LLM_URL=http://ollama:11434/v1
# CORTEX_ANSWER_URL=http://ollama:11434/v1
# CORTEX_VERIFIER_URL=http://ollama:11434/v1
# CORTEX_ANSWER_API_KEY=ollama-local
# CORTEX_VERIFIER_API_KEY=ollama-local
# CORTEX_ENTITY_API_KEY=ollama-local
# CORTEX_LLM_MAX_IN_FLIGHT=1
# --------------------------------------------------------------------------------

# --- Answer / verifier tuning ---
CORTEX_ANSWER_MAX_TOKENS=1500
CORTEX_VERIFIER_MAX_TOKENS=16384
CORTEX_FACT_VALIDITY_FILTER=1
CORTEX_SYNC_FACT_EXTRACT_MAX_SESSIONS=12
CORTEX_SYNC_GRAPH_SEED_MAX_BULK_MEMORIES=96

# --- Embedding batching / timeouts ---
CORTEX_EMBEDDING_MAX_BATCH_ITEMS=2048
CORTEX_EMBEDDING_HTTP_TIMEOUT_SECS=30
CORTEX_EMBEDDING_RETRY_ATTEMPTS=1
CORTEX_EMBEDDING_RETRY_BASE_DELAY_MS=250

# --- Media extraction (blob_ref content processors) ---
#   Documents (pdf/docx/xlsx/...) -> Apache Tika sidecar. No cloud key needed.
CORTEX_DOCUMENT_PROVIDER=tika
CORTEX_DOCUMENT_API_URL=http://tika:9998
#   Images -> OpenAI vision, Audio -> OpenAI Whisper.
#   These two REQUIRE a real OpenAI API key. If you don't need image/audio
#   ingestion, you can leave the key blank and only document extraction will run.
CORTEX_IMAGE_PROVIDER=openai
CORTEX_IMAGE_API_URL=https://api.openai.com/v1
CORTEX_IMAGE_MODEL=gpt-4o
CORTEX_IMAGE_MAX_TOKENS=1024
CORTEX_AUDIO_PROVIDER=openai-whisper
CORTEX_AUDIO_API_URL=https://api.openai.com/v1
CORTEX_AUDIO_MODEL=whisper-1
CORTEX_IMAGE_API_KEY=<YOUR_OPENAI_API_KEY>
CORTEX_AUDIO_API_KEY=<YOUR_OPENAI_API_KEY>

# ================= OPTIONAL FEATURE TOGGLES (both OFF by default) =================
#  To enable either feature: delete the leading "#" on its variable line(s) below,
#  then recreate the container so it reloads this file (setup guide section 9.0).

# [1] Code Intelligence Plane: repo ingestion + code-aware queries (cited context, symbol
#     search, callers/callees, impact). After enabling, MOUNT the repo under /repos inside the
#     container (-v /host/repo:/repos/NAME:ro), then POST /v1/code/repos and
#     POST /v1/code/context (guide section 9a; docs https://cortexdb.ai/docs/features/code-plane).
#     CORTEX_CODE_REPO_ROOTS limits registration to that directory.
#     >>> uncomment BOTH to ENABLE:
# CORTEX_CODE_PLANE=1
# CORTEX_CODE_REPO_ROOTS=/repos

# [2] LLM enrichment: extra fact/graph extraction ("fact augmentation") beyond raw content.
#     While OFF you get content-only mode (extraction still runs; boot logs say so).
#     To ENABLE fact augmentation you must give enrichment its OWN LLM endpoint
#     (MODEL + URL + API_KEY) plus the deferred-scan cadence. It does NOT reuse the answer
#     lane's key. Recommended model: OpenAI gpt-4o-mini
#     (about $0.40 per 1,000 events; about $4 to load and enrich 10,000 events).
#     NOTE: calls the LLM per ingested item (uses OpenAI quota; slow on CPU-only Qwen).
#     DELAY_SECONDS = seconds to wait after a write before enriching; CONCURRENCY = parallel jobs.
#     (Keep values bare: docker --env-file treats a trailing "# comment" as part of the value.)
#     >>> uncomment ALL to ENABLE:
# CORTEX_ENRICHMENT_MODEL=gpt-4o-mini
# CORTEX_ENRICHMENT_URL=https://api.openai.com/v1
# CORTEX_ENRICHMENT_API_KEY=<YOUR_OPENAI_API_KEY>
# CORTEX_ENRICHMENT_DELAY_SECONDS=5
# CORTEX_ENRICHMENT_CONCURRENCY=2
# =================================================================================

# --- Server / runtime ---
CORTEX_API_KEY=noauth-local
CORTEX_CHANNEL=docker
CORTEX_BIND_ALL=1
# Keep the audit log on the data volume; without this line it is held in memory only and
# starts empty after every restart.
CORTEX_V1_AUDIT_PATH=/data/audit.jsonl
RUST_LOG=cortexdb=info,cortex_api=info,cortex_coordinator=info,cortex_gossip=info,cortex_vector_index=info
